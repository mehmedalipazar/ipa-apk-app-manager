# =============================================================================
#  BACKEND — GELISTIRME
#
#  Yuklenme sirasi (sonraki oncekini ezer):
#      .env.development  ->  .env.local  ->  gercek ortam degiskeni
#
#  Bu dosya depoya girer ve SIR ICERMEZ. Makineye ozel degerler ve sirlar
#  .env.local dosyasina yazilir (gitignore'da).
#
#  Calistirma:  npm run dev:backend
# =============================================================================

NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=debug

# --- Veri ---------------------------------------------------------------------
# Depo icinde: SQLite dosyasini dogrudan acabilmek icin.
#     sqlite3 backend/data/ipa-ota.db
DATA_DIR=./data

# --- Adresler -----------------------------------------------------------------
# PUBLIC_BASE_URL: iOS'un gordugu MUTLAK adres. Kurulum linklerinin ve
# manifest.plist icindeki her URL'nin kokudur. Gelistirmede bile uretim
# alan adini kullaniyoruz: iOS OTA kurulumu yalnizca gecerli sertifikali
# HTTPS uzerinden calisir, http://localhost ile GERCEK CIHAZA KURULUM YAPILAMAZ.
#
# Yerel makinede uretilen linkin acilabilmesi icin bu adresin bu servise
# ulasmasi gerekir (ters proxy ya da tunel). Yalnizca arayuzu/yuklemeyi
# deniyorsaniz http://localhost:3000 yazip gecebilirsiniz.
PUBLIC_BASE_URL=https://ipa-ios.simurgbilisim.com

# Kurulum uclarinin yol oneki. Gelistirmede ters proxy olmadigi icin kisa hali.
INSTALL_PATH_PREFIX=/i

# --- Arayuz baglantisi --------------------------------------------------------
# Gelistirmede arayuz Vite'in kendi sunucusunda (5173) AYRI bir origin'de
# calisir; bu yuzden CORS acik olmak zorunda. Uretimde bu satir BOSTUR.
CORS_ORIGINS=http://localhost:5173

# CORS_ORIGINS dolu oldugu icin 'auto' bunlari none+secure yapar.
# localhost tarayicilar tarafindan guvenli sayildigindan cerez yine calisir.
COOKIE_SAMESITE=auto
COOKIE_SECURE=auto

TRUST_PROXY=false

# --- Sirlar -------------------------------------------------------------------
# BURAYA YAZMAYIN. backend/.env.local dosyasina koyun:
#     ADMIN_PASSWORD=...
#     SESSION_SECRET=...     (openssl rand -hex 32)
#
# SESSION_SECRET bos birakilirsa gelistirmede her yeniden baslatmada yeni bir
# anahtar uretilir; oturumlar ve uretilmis imzali linkler duser.
