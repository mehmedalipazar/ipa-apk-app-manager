# =============================================================================
#  BACKEND — docker compose SABLONU
#
#      cd backend && cp .env.example .env && docker compose up -d --build
#
#  BU DOSYAYI KIM OKUR?
#      YALNIZCA `docker compose`. Bu dizindeki docker-compose.yml icindeki
#      ${DEGISKEN} ifadeleri buradan cozulur.
#
#  NODE BU DOSYAYI OKUMAZ. Uygulamanin kendi ortam dosyalari ayridir ve
#  package.json icinde --env-file-if-exists ile ACIKCA listelenir:
#      npm run dev    ->  .env.development  ->  .env.local
#      npm start      ->  .env.production   ->  .env.local
#  `.env` bu listelerde YOKTUR; yalnizca compose'a aittir.
#
#  Uretim varsayilanlari .env.production icindedir ve imaja gomulur;
#  buradaki degerler compose'un `environment:` blogu uzerinden onlari EZER
#  (gercek ortam degiskeni her zaman dosyayi yener).
#
#  Frontend'in bununla HICBIR ILGISI YOKTUR — ayri servis, ayri .env,
#  ayri docker-compose.yml (bkz. ../frontend/.env.example).
# =============================================================================

# --- Sirlar (ZORUNLU) ---------------------------------------------------------
# Bos birakilirsa `docker compose up` hata verip durur.

# Admin paneli sifresi (en az 8 karakter).
# YALNIZCA ILK ACILISTA okunur; sonrasinda panelden degistirilen sifre gecerlidir.
ADMIN_PASSWORD=

# Oturum cerezi ve imzali kurulum linklerinin HMAC anahtari.
#     openssl rand -hex 32
# DEGISTIRIRSENIZ tum oturumlar ve dagitilmis imzali linkler duser.
SESSION_SECRET=

# Sifreyi sifirlamak icin bir kez true yapip baslatin, sonra geri alin.
ADMIN_PASSWORD_FORCE_RESET=false

# --- Adres --------------------------------------------------------------------
# iOS'un gordugu mutlak adres. HTTPS ve gecerli (self-signed olmayan, tam
# zincirli) sertifika ZORUNLU — aksi halde kurulum telefonda hicbir hata
# mesaji vermeden basarisiz olur.
PUBLIC_BASE_URL=https://ipa-ios.simurgbilisim.com

# Kurulum uclarinin yol oneki. Ters proxy yalnizca /api/* yolunu bu servise
# yonlendiriyorsa /api/i birakin.
INSTALL_PATH_PREFIX=/api/i

# --- Arayuz baglantisi --------------------------------------------------------
# Ayri origin'den baglanmasina izin verilen arayuzler (virgullu liste).
# Frontend ARTIK TAMAMEN AYRI BIR SERVIS: ona hicbir sey dayatmaz, sadece
# hangi origin'lerin bu API'ye baglanabilecegini soyler.
#
#   bos                      -> ayni-origin duzen, cerez SameSite=Lax
#   http://localhost:5173    -> yerel gelistirme arayuzu bu API'ye baglanabilir;
#                               cerez SameSite=None olur, CSRF korumasini
#                               backend'deki Origin dogrulama katmani saglar.
CORS_ORIGINS=http://localhost:5173

# --- Calisma ------------------------------------------------------------------
# Host portu (container icinde port her zaman 3000).
API_PORT=3000
LOG_LEVEL=info

# Ters proxy arkasindaysaniz true. Proxy YOKSA false yapin: aksi halde istemci
# X-Forwarded-For ile kendi IP'sini uydurabilir.
TRUST_PROXY=true

# --- Veritabani tarayicisi (dbadmin) ------------------------------------------
# SALT OKUNUR SQLite arayuzu. VARSAYILAN OLARAK CALISMAZ; acmak icin:
#     docker compose --profile dbadmin up -d dbadmin
# Kalici acmak icin asagidaki satirin yorumunu kaldirin:
# COMPOSE_PROFILES=dbadmin
#
# Arayuz sifresi. Profil acikken ZORUNLU (bos ise compose durur).
#     openssl rand -hex 16
DBADMIN_PASSWORD=

# Host portu ve dinlenecek adres.
# 127.0.0.1 = yalnizca bu makineden erisilir (ONERILEN — burasi uretim sunucusu).
# 0.0.0.0   = LAN'a acilir; tek koruma DBADMIN_PASSWORD olur.
DBADMIN_PORT=8081
DBADMIN_BIND=127.0.0.1
