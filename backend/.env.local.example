# =============================================================================
#  BACKEND — makineye ozel degerler ve SIRLAR
#
#  Bu dosyayi .env.local olarak kopyalayin:
#      cp backend/.env.local.example backend/.env.local
#
#  .env.local gitignore'dadir ve .env.development / .env.production
#  dosyalarindaki her degeri ezer.
# =============================================================================

# Admin paneli sifresi. YALNIZCA ILK ACILISTA okunur ve ozetlenip veritabanina
# yazilir; sonraki acilislarda yok sayilir (panelden degistirilen sifre
# yeniden baslatmada geri donmesin diye).
# Sifirlamak icin bir kez ADMIN_PASSWORD_FORCE_RESET=true ile baslatin.
ADMIN_PASSWORD=degistir-beni-en-az-8-karakter

# Oturum cerezi VE imzali kurulum linklerinin HMAC anahtari.
# Uretmek icin:  openssl rand -hex 32
# DEGISTIRIRSENIZ tum oturumlar ve dagitilmis tum imzali linkler duser.
SESSION_SECRET=

# --- Istege bagli ezmeler -----------------------------------------------------
# Yerel veritabanini baska bir yere almak isterseniz:
# DATA_DIR=./data

# Kurulum linklerini yerelde uretip denemek isterseniz (gercek cihaza kurulum
# yapilamaz, yalnizca sayfa/akis testi icin):
# PUBLIC_BASE_URL=http://localhost:3000

# ADMIN_PASSWORD_FORCE_RESET=true
