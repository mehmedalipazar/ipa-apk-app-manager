{
  "name": "@ipa-ota/backend",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env.development --env-file-if-exists=.env.local --experimental-strip-types src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env.production --env-file-if-exists=.env.local dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.0.1",
    "@fastify/formbody": "^8.0.2",
    "@fastify/multipart": "^9.0.3",
    "better-sqlite3": "^11.8.1",
    "bplist-parser": "^0.3.2",
    "fastify": "^5.2.1",
    "plist": "^3.1.0",
    "qrcode": "^1.5.4",
    "yauzl": "^3.2.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.5",
    "@types/plist": "^3.0.5",
    "@types/qrcode": "^1.5.5",
    "@types/yauzl": "^2.10.3",
    "pino-pretty": "^13.1.3",
    "typescript": "^5.7.3"
  }
}
