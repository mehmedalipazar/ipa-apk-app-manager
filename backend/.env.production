# =============================================================================
#  BACKEND — URETIM
#
#  Yuklenme sirasi (sonraki oncekini ezer):
#      .env.production  ->  .env.local  ->  gercek ortam degiskeni
#
#  Bu dosya imaja kopyalanir ve SIR ICERMEZ. ADMIN_PASSWORD ve SESSION_SECRET
#  docker compose'un `environment:` blogundan gelir; gercek ortam degiskeni
#  bu dosyadaki her degeri ezer.
#
#  TOPOLOJI: arayuz ve API ayni alan adi altinda, onlerinde ters proxy var.
#      https://ipa-ios.simurgbilisim.com/        ->  web  (nginx, SPA)
#      https://ipa-ios.simurgbilisim.com/api/*   ->  api  (bu servis)
#  Tarayici bu yuzden goreli yol kullanir; CORS'a hic gerek yoktur.
# =============================================================================

NODE_ENV=production
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# --- Veri ---------------------------------------------------------------------
# Container icindeki yol. docker-compose bunu host'taki ./data-docker
# dizinine baglar; SQLite dosyasi host'tan dogrudan okunabilir.
DATA_DIR=/data

# --- Adresler -----------------------------------------------------------------
# iOS'un gordugu mutlak adres. HTTPS ZORUNLU ve sertifika gecerli olmali:
# aksi halde kurulum telefonda HICBIR HATA MESAJI VERMEDEN basarisiz olur.
PUBLIC_BASE_URL=https://ipa-ios.simurgbilisim.com

# Ters proxy yalnizca /api/* yolunu bu servise yonlendiriyor; kurulum uclari
# da o yoldan gecsin diye onek /api/i.
INSTALL_PATH_PREFIX=/api/i

# --- Arayuz baglantisi --------------------------------------------------------
# BOS BIRAKIN. Arayuz ayni origin uzerinden sunuldugu icin CORS gereksizdir.
# Buraya kendi alan adinizi yazmak, oturum cerezini gereksiz yere
# SameSite=None'a dusurur ve korumayi zayiflatir.
CORS_ORIGINS=

# CORS_ORIGINS bos => SameSite=Lax, Secure=true (uretim).
COOKIE_SAMESITE=auto
COOKIE_SECURE=auto

# Ters proxy arkasindayiz: X-Forwarded-* basliklarina guven.
TRUST_PROXY=true
