# =============================================================================
#  FRONTEND — makineye ozel ezmeler
#
#  Kopyalayin:
#      cp frontend/.env.local.example frontend/.env.local
#
#  .env.local gitignore'dadir ve .env.development degerlerini ezer.
# =============================================================================

# YEREL BACKEND'E BAGLAN.
#
# Bu satir acikken arayuz http://localhost:3000 adresindeki backend'e konusur;
# yuklediginiz her sey backend/data/ipa-ota.db icine yazilir ve dogrudan
# sqlite3 ile okunabilir:
#     sqlite3 backend/data/ipa-ota.db "select app_name, version from builds;"
#
# Satiri silerseniz/yorumlarsaniz arayuz .env.development'taki uretim API'sine
# doner (https://ipa-ios.simurgbilisim.com).
VITE_API_BASE_URL=http://localhost:3000
