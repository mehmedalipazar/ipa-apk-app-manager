# =============================================================================
#  FRONTEND — makineye ozel ezmeler
#
#  Kopyalayin:
#      cp frontend/.env.local.example frontend/.env.local
#
#  .env.local gitignore'dadir ve .env.development degerlerini ezer.
# =============================================================================

# YEREL BACKEND'E BAGLAN (canli veriye dokunmadan gelistirme).
#
# Bu satir acikken arayuz http://localhost:3000 adresindeki backend'e konusur;
# yuklediginiz her sey backend/data/ipa-ota.db icine yazilir. Satiri
# yorumlarsaniz arayuz .env.development'taki CANLI API'ye doner — oradaki
# islemler gercek uretim verisini degistirir.
VITE_API_BASE_URL=http://localhost:3000
