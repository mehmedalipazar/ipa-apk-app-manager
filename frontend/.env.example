# =============================================================================
#  FRONTEND — docker compose SABLONU
#
#      cd frontend && cp .env.example .env && docker compose up -d --build
#
#  DIKKAT — BU DOSYAYA "VITE_" ILE BASLAYAN HICBIR SEY YAZMAYIN.
#
#  Bu dizinde iki AYRI amacli .env ailesi vardir:
#
#    1) .env                        -> YALNIZCA docker compose okur.
#                                      docker-compose.yml icindeki ${DEGISKEN}
#                                      ifadeleri buradan cozulur (host portu vb).
#
#    2) .env.development            -> Vite okur (arayuzun kendi ayarlari).
#       .env.production                Derleme zamaninda paketlenir.
#       .env.development.local         (makineye ozel ezme, gitignore'da)
#
#  Vite `.env` dosyasini da yukler ve sirasi soyledir (sonraki oncekini ezer):
#      .env  ->  .env.local  ->  .env.[mode]  ->  .env.[mode].local
#  Yani buraya yazilan bir VITE_ degiskeni, .env.[mode] ayni anahtari
#  tanimlamiyorsa sessizce derlemeye sizar. API adresi burada DEGIL,
#  .env.development / .env.production icinde tanimlanir.
#
#  Backend'in bununla HICBIR ILGISI YOKTUR — ayri servis, ayri .env,
#  ayri docker-compose.yml (bkz. ../backend/.env.example).
# =============================================================================

# Arayuzun yayinlanacagi HOST portu. Container icinde nginx her zaman 8080
# dinler; burasi yalnizca disariya acilan portu belirler.
WEB_PORT=5173
