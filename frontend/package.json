{
  "name": "ipa-ota-frontend",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "iOS OTA IPA dagitim servisi - admin arayuzu (React SPA). Bagimsiz servis; backend ile tek baglantisi HTTP'dir.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f web"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.3",
    "vite": "^6.2.0"
  }
}
