# =============================================================================
#  FRONTEND — GELISTIRME
#
#  Vite'in yukleme sirasi (sonraki oncekini ezer):
#      .env  ->  .env.development  ->  .env.local  ->  .env.development.local
#
#  Bu dosya depoya girer. Yalnizca VITE_ onekli degiskenler pakete gecer.
#
#  Calistirma:  npm run dev:frontend      (http://localhost:5173)
# =============================================================================

# Arayuzun API'yi arayacagi kok adres.
#
# Varsayilan olarak URETIMDEKI API kullanilir: iOS OTA kurulumu yalnizca
# gecerli sertifikali HTTPS uzerinden calistigi icin gercek cihaz testi ancak
# bu adresle yapilabilir.
#
# YEREL BACKEND'E BAGLANMAK ICIN (SQLite verilerini yerelde gormek istiyorsaniz)
# frontend/.env.local dosyasina su satiri yazin — burayi degistirmeyin:
#     VITE_API_BASE_URL=http://localhost:3000
VITE_API_BASE_URL=https://ipa-ios.simurgbilisim.com
