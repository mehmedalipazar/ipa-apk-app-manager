# =============================================================================
#  KOK .env SABLONU — docker compose sirlari
#
#      cp .env.example .env
#
#  docker compose YALNIZCA .env dosyasini okur.
#  Uretim varsayilanlari backend/.env.production icindedir ve imaja gomulur;
#  buradaki degerler onlari EZER.
#
#  Yerel gelistirme icin bu dosya KULLANILMAZ — bkz:
#      backend/.env.local.example
#      frontend/.env.local.example
# =============================================================================

# --- Sirlar (ZORUNLU) ---------------------------------------------------------
# Bos birakilirsa `docker compose up` hata verip durur.

# Admin paneli sifresi (en az 8 karakter).
# YALNIZCA ILK ACILISTA okunur; sonrasinda panelden degistirilen sifre gecerlidir.
ADMIN_PASSWORD=

# Oturum cerezi ve imzali kurulum linklerinin HMAC anahtari.
#     openssl rand -hex 32
SESSION_SECRET=

# Sifreyi sifirlamak icin bir kez true yapip baslatin.
ADMIN_PASSWORD_FORCE_RESET=false

# --- Adres --------------------------------------------------------------------
# iOS'un gordugu mutlak adres. HTTPS ve gecerli (self-signed olmayan, tam
# zincirli) sertifika ZORUNLU — aksi halde kurulum telefonda hicbir hata
# mesaji vermeden basarisiz olur.
PUBLIC_BASE_URL=https://ipa-ios.simurgbilisim.com

# Kurulum uclarinin yol oneki. Ters proxy yalnizca /api/* yolunu api servisine
# yonlendiriyorsa /api/i birakin.
INSTALL_PATH_PREFIX=/api/i

# BOS BIRAKIN. Arayuz ile API ayni alan adi altinda sunuluyor; arayuz goreli
# yol kullanir. Doldurmak oturum cerezini gereksizce SameSite=None yapar.
CORS_ORIGINS=

# --- Host portlari ------------------------------------------------------------
API_PORT=3000
WEB_PORT=5173
LOG_LEVEL=info
